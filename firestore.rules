rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication and ownership verification helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. System connection probe for health check
    match /system/{probeId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // 2. User profile documents (users/{userId})
    match /users/{userId} {
      // A signed-in student can read only their own profile
      allow read: if isOwner(userId);

      // Create allowed only if authenticated user is the owner
      allow create: if isOwner(userId)
                    && (!('id' in request.resource.data) || request.resource.data.id == userId);

      // Update allowed only if ownership identifier cannot be tampered with
      allow update: if isOwner(userId)
                    && (!('id' in request.resource.data) || request.resource.data.id == userId);

      // User can delete their own profile document
      allow delete: if isOwner(userId);

      // User preferences subcollection: users/{userId}/settings/preferences
      match /settings/preferences {
        allow read, write: if isOwner(userId);
      }

      // Study plans subcollection: users/{userId}/studyPlans/{planId}
      match /studyPlans/{planId} {
        allow read, write: if isOwner(userId);
      }

      // Individual study tasks: users/{userId}/tasks/{taskId}
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      // Study notes: users/{userId}/notes/{noteId}
      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      // Quiz assessment history: users/{userId}/quizHistory/{attemptId}
      match /quizHistory/{attemptId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 3. Explicit default-deny: everything else is forbidden
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
