# Google Gemini API Key: Required for server-side Gemini API inference.
# Provided automatically in AI Studio or via environment variables.
# NEVER prefix with VITE_ or expose to the frontend.
GEMINI_API_KEY=

# Server Port (default 3000)
PORT=3000

# Firebase Web Client Configuration (Client-side, prefixed with VITE_)
# Obtain from Firebase Console -> Project Settings -> General -> Your Apps (Web)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_ID=

